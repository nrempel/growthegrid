---
import LineArt from '../components/LineArt.astro';
import HowItWorks from '../components/HowItWorks.astro';
import mlas from '../data/mlas.json';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import { UPDATED } from '../data/site';
import { socialLinks } from '../data/social';
import JoinForm from '../components/JoinForm.astro';
const shareBubbles = socialLinks(Astro.site?.toString() ?? 'https://growthegrid.ca/', 'bubble');

const ridings = Object.keys(mlas).sort((a, b) => a.localeCompare(b));
const title = 'Let data centres build BC’s next power plant | Grow the Grid BC';
const description =
  'Data centres want to build in BC. Ask your MLA to let them in if they bring more new power than they use, so BC gets a bigger grid. Find your MLA by postal code.';
const ogDescription = 'Let data centres build in BC if they bring more new power than they use. Ask your MLA. Takes about a minute.';
const site = Astro.site?.toString() ?? 'https://growthegrid.ca/';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite', '@id': `${site}#site`, url: site, name: 'Grow the Grid BC',
      alternateName: ['Grow the Grid', 'growthegrid.ca'], inLanguage: 'en-CA', publisher: { '@id': `${site}#person` },
    },
    { '@type': 'Person', '@id': `${site}#person`, name: 'Nicholas Rempel', email: 'hello@growthegrid.ca' },
    {
      '@type': 'WebPage', '@id': `${site}#page`, url: site, name: title, isPartOf: { '@id': `${site}#site` },
      about: 'Data centre electricity rules in British Columbia', inLanguage: 'en-CA', dateModified: UPDATED,
    },
  ],
});

// Sources used more than once. Every factual sentence links one of these or its own URL.
const U = {
  reg: 'https://www.bclaws.gov.bc.ca/civix/document/id/complete/statreg/8_2026',
  cfd: 'https://app.bchydro.com/accounts-billing/electrical-connections/large-load/emerging-industries-connections.html',
  rfa: 'https://www.bchydro.com/content/dam/BCHydro/customer-portal/documents/accounts-billing/electrical-connections/2026-cfd-request-for-applications.pdf',
  call: 'https://news.gov.bc.ca/releases/2026ECS0014-000552',
  asp24: 'https://www.bcbudget.gov.bc.ca/Annual_Reports/2023_2024/pdf/agency/bchydro.pdf',
  asp26: 'https://www.bcbudget.gov.bc.ca/Annual_Reports/2025_2026/pdf/agency/bchydro.pdf',
  irp: 'https://docs.bcuc.com/documents/proceedings/2025/doc_84202_b-1-bch-2025-irp-application.pdf',
  drought: 'https://news.gov.bc.ca/releases/2026WLRS0046-000999',
  ised: 'https://ised-isde.canada.ca/site/ised/en/canadas-responsible-data-centre-development-principles',
  gcsov: 'https://www.canada.ca/en/government/system/digital-government/digital-government-innovations/cloud-services/gc-white-paper-data-sovereignty-public-cloud.html',
  leger: 'https://documents.leger360.com/hubfs/%C3%89tudes%20M%C3%A9diatiques/%C3%89tudes%20M%C3%A9diatiques%20-%202026/7.%20%C3%89tudes%20m%C3%A9diatiques%20Juillet%202026/Leger_Survey_AI_Data_Centres_July2026.pdf',
  ohio: 'https://www.aepohio.com/company/about/rates/data-center-tariff',
  ireland: 'https://www.cru.ie/about-us/news/the-cru-publishes-its-decision-on-new-electricity-connection-policy-for-data-centres/',
  groundwater: 'https://www2.gov.bc.ca/gov/content/environment/air-land-water/water/groundwater-wells-aquifers/information-for-well-owners/well-records-registration/non-domestic-groundwater-use',
  statcan: 'https://www150.statcan.gc.ca/n1/pub/16-201-x/2017000/sec-2-eng.htm',
  microsoft: 'https://www.microsoft.com/en-us/microsoft-cloud/blog/2024/12/09/sustainable-by-design-next-generation-datacenters-consume-zero-water-for-cooling/',
  ltep: 'https://www.bchydro.com/news/press_centre/news_releases/2025/ltep.html',
  shortfall: 'https://news.gov.bc.ca/releases/2026ECS0045-000916',
};

const reasons = [
  'My power bill keeps going up, and I don’t want data centres adding to it.',
  'I want BC’s water protected, with clear rules for every new site.',
  'I want Canadian data kept under Canadian control.',
  'I want the construction jobs and new power built here in BC.',
];

// Bars are drawn on a 0–1,000 MW scale. Sources: B.C. Reg. 8/2026, BC Hydro 2026 Call for Demand, Alberta Major Projects.
const bars = [
  { mw: 400, label: 'BC’s limit for all new data centres', sub: 'Feb 2026 to Jan 2028', tone: 'cap' },
  { mw: 800, approx: true, label: 'What 15 applications asked BC Hydro for', sub: '2026 Call for Demand', tone: 'ask' },
  { mw: 1000, approx: true, label: 'One gigawatt-scale AI campus', sub: 'like the one Meta announced in Alberta in July 2026', tone: 'want' },
];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <Head title={title} description={description} ogTitle="Let data centres build BC’s next power plant" ogDescription={ogDescription} jsonLd={jsonLd} />
  </head>
  <body data-share-url={site}>
    <header class="nav">
      <a class="brand" href="#top">Grow the Grid BC</a>
      <a class="nav-cta" href="#act">Email your MLA</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-copy">
          <h1>Let data centres build BC’s next power plant.</h1>
          <p class="lede">
            Data centres want to build in BC. Let’s say yes, on one condition: they bring more new power than they use.
            The extra goes to everyone, so BC gets a bigger grid.
          </p>
          <div class="hero-lookup">
            <a class="btn btn-hot" id="hero-cta" href="#act">Email your MLA</a>
            <p class="hero-note">Find your MLA by postal code. Takes about a minute.</p>
          </div>
          <p class="counter" id="counter" hidden><strong id="count">0</strong> <span id="count-label">letters started so far</span></p>
        </div>
        <LineArt />
      </section>

      <section class="numbers" id="numbers">
        <div class="wrap">
          <div class="opp">
            <p class="opp-head">Data centres are lining up to build here. If they pay their way, BC gets more power, more jobs and more say over its data.</p>
            <ul class="stats">
              <li>
                <p class="stat-num"><span aria-hidden="true">~</span><span class="sr-only">about </span>800 MW</p>
                <p>asked for by 15 data centre applications in 2026, twice what BC can offer</p>
                <p class="srcs"><a href={U.cfd} target="_blank" rel="noopener">BC Hydro</a></p>
              </li>
              <li>
                <p class="stat-num">350,000</p>
                <p>homes’ worth of new power from the four wind projects BC Hydro picked in its 2025 call for power. Data centre money could pay for the next round.</p>
                <p class="srcs"><a href={U.call} target="_blank" rel="noopener">BC Gov News, May 2026</a></p>
              </li>
              <li>
                <p class="stat-num">2,500+ jobs</p>
                <p>More than 1,000 to build TELUS’s BC data centre sites, and 1,500 from the four new wind projects</p>
                <p class="srcs"><a href="https://www.telus.com/en/about/news-and-events/media-releases/TELUS-and-Government-of-Canada-advance-work-to-scale-Canadas-sovereign-AI-infrastructure" target="_blank" rel="noopener">TELUS</a> <a href={U.call} target="_blank" rel="noopener">BC Gov News, May 2026</a></p>
              </li>
            </ul>
            <p class="opp-why"><strong>Why now:</strong> The new government can change the cap without a new law, and BC Hydro will pick which projects get power once the new government is in place. Ask your MLA to make sure any change comes with the terms below. <span class="srcs"><a href={U.reg} target="_blank" rel="noopener">B.C. Reg. 8/2026</a> <a href={U.cfd} target="_blank" rel="noopener">BC Hydro</a></span></p>
          </div>
          <div class="intro">
            <h2 class="long">Today’s cap splits up a fixed amount of power. A “pay to connect” rule would grow the supply.</h2>
            <p class="section-lede">
              Since February 2026, a provincial regulation has capped the power BC Hydro can supply to new data centres at 400 MW over two years: 300 MW for AI data centres and 100 MW for others. Here is that cap next to what they asked for and what one large campus would use. <span class="srcs"><a href={U.reg} target="_blank" rel="noopener">B.C. Reg. 8/2026</a></span>
            </p>
          </div>

          <figure class="chart" aria-label="Data centre power in megawatts">
            <div class="scale" aria-hidden="true">
              <span style="left:0%">0</span>
              <span style="left:25%">250</span>
              <span style="left:50%">500</span>
              <span style="left:75%">750</span>
              <span style="left:100%">1,000 MW</span>
            </div>
            {bars.map((b) => (
              <div class={`bar-row tone-${b.tone}`}>
                <p class="bar-label">{b.label} <span class="bar-sub">{b.sub}</span></p>
                <div class="track">
                  <span class="fill" style={`width:${b.mw / 10}%`} />
                  <span class="val" style={`left:${b.mw / 10}%`}>
                    {b.approx && (<><span aria-hidden="true">~</span><span class="sr-only">about </span></>)}{b.mw.toLocaleString('en-CA')} MW
                  </span>
                </div>
              </div>
            ))}
            <p class="chart-note">Data centres asked for about 800 MW. The rules let BC Hydro offer 400, and no more than 145 to any one project.</p>
            <figcaption class="srcs">
              Sources: <a href={U.reg} target="_blank" rel="noopener">B.C. Reg. 8/2026</a>, <a href={U.cfd} target="_blank" rel="noopener">BC Hydro 2026 Call for Demand</a>, <a href="https://majorprojects.alberta.ca/details/Meta-Data-Centre/12183" target="_blank" rel="noopener">Alberta Major Projects (Meta)</a>.
            </figcaption>
          </figure>

          <ul class="stats also">
            <li>
              <p class="stat-title">We need more power anyway.</p>
              <p>BC Hydro expects demand to grow about 15% by 2030, and the province says BC needs more generating capacity sooner than expected. The question is who pays to build it.</p>
              <p class="srcs"><a href={U.ltep} target="_blank" rel="noopener">BC Hydro</a> <a href={U.shortfall} target="_blank" rel="noopener">BC Gov News, Aug 2026</a></p>
            </li>
            <li>
              <p class="stat-title">A bigger grid for dry years.</p>
              <p>In the 2023-24 drought, BC Hydro’s dams made about 30% less power than the year before, and it bought, on net, about a quarter of its power from outside BC. Its plan says a wider mix of sources makes the grid less dependent on hydro in a drought. Data centres can pay for that new supply.</p>
              <p class="srcs"><a href={U.asp24} target="_blank" rel="noopener">BC Hydro 2023/24 annual report</a> <a href={U.asp26} target="_blank" rel="noopener">2025/26 report</a> <a href={U.irp} target="_blank" rel="noopener">2025 plan</a></p>
            </li>
            <li>
              <p class="stat-title">Other places are setting terms.</p>
              <p>Quebec proposes a data centre rate about double what other large customers pay. Alberta moves projects that bring their own power to the front of the line.</p>
              <p class="srcs"><a href="https://news.hydroquebec.com/news/press-releases/all-quebec/hydro-quebec-proposing-regie-energie-new-rate-large-data-centres-adjustment-rate-cryptographic-use-applied-blockchains.html" target="_blank" rel="noopener">Hydro-Québec</a> <a href="https://www.alberta.ca/datacentres/grid.html" target="_blank" rel="noopener">Government of Alberta</a></p>
            </li>
          </ul>
        </div>
      </section>

      <section class="proof pillar" id="water">
        <div class="wrap">
          <div class="intro">
            <h2>Plenty of water, and rules to protect it.</h2>
            <p class="section-lede">Microsoft’s newest design cools with a sealed loop that reuses the same water. <span class="srcs"><a href={U.microsoft} target="_blank" rel="noopener">Microsoft</a></span></p>
          </div>

          <ul class="stats water">
            <li>
              <p class="stat-label">BC has it</p>
              <p class="stat-num">#1</p>
              <p>BC’s coast has the highest water yield per square metre in Canada.</p>
              <p class="srcs"><a href={U.statcan} target="_blank" rel="noopener">Statistics Canada</a></p>
            </li>
            <li>
              <p class="stat-label">New designs barely use it</p>
              <p class="stat-num">125M+ litres</p>
              <p>of water a year that Microsoft says each data centre on its new sealed-loop design will avoid, about 50 Olympic pools.</p>
              <p class="srcs"><a href={U.microsoft} target="_blank" rel="noopener">Microsoft, Dec 2024</a></p>
            </li>
            <li>
              <p class="stat-label">BC can enforce it</p>
              <p class="stat-num">Licence</p>
              <p>Industry needs a provincial licence to draw groundwater or stream water, and BC can cut industrial use in a drought, as it did at Bessette Creek in August 2026. BC Hydro already scores water use efficiency when it picks projects. BC can go further and make sealed-loop cooling and public water reports a condition of connecting.</p>
              <p class="srcs"><a href={U.groundwater} target="_blank" rel="noopener">Government of BC</a> <a href={U.drought} target="_blank" rel="noopener">BC Gov News, Aug 28, 2026</a> <a href={U.rfa} target="_blank" rel="noopener">BC Hydro 2026 request for applications</a></p>
            </li>
          </ul>
        </div>
      </section>

      <section class="proof pillar pillar-ice" id="sovereign">
        <div class="wrap">
          <div class="intro">
            <h2>Keep Canadian data in Canadian hands.</h2>
            <p class="section-lede">Hospitals, schools and BC businesses need somewhere safe to keep their data. BC can favour data centres that Canadians control, with no new law.</p>
          </div>

          <ul class="stats sov">
            <li>
              <p class="stat-label">Already in the rules</p>
              <p class="stat-num">30 of 100</p>
              <p>points in BC Hydro’s grading of data centres competing for power go to keeping data in Canadian hands. BC Hydro plans to write the winners’ promises into their contracts. They should be published too.</p>
              <p class="srcs"><a href={U.rfa} target="_blank" rel="noopener">BC Hydro 2026 request for applications</a> <a href={U.reg} target="_blank" rel="noopener">B.C. Reg. 8/2026</a></p>
            </li>
            <li>
              <p class="stat-label">Why it matters</p>
              <p class="stat-num">Who runs it</p>
              <p>Storing data here isn’t enough. Ottawa says data kept in Canada by a foreign-run company can still be subject to foreign laws.</p>
              <p class="srcs"><a href={U.gcsov} target="_blank" rel="noopener">Government of Canada</a></p>
            </li>
            <li>
              <p class="stat-label">Industry signed on</p>
              <p class="stat-num">5 companies</p>
              <p>AWS, Microsoft, Bell, TELUS and Cohere signed Ottawa’s data centre principles. The principles say data centre growth must not shift power costs onto households, and call for access to computing for Canadian businesses and institutions. These companies have not endorsed this campaign.</p>
              <p class="srcs"><a href={U.ised} target="_blank" rel="noopener">Government of Canada, data centre principles</a></p>
            </li>
          </ul>
        </div>
      </section>

      <section class="proof" id="deal">
        <div class="wrap">
          <div class="intro">
            <h2>How a “pay to connect” deal would work</h2>
            <p class="section-lede">Five rules. Each builds on a precedent elsewhere or on BC’s own rules, and the first goes further than any of them.</p>
          </div>

          <HowItWorks />

          <ol class="rules">
            <li>
              <h3>Bring more power than you use</h3>
              <p>To plug in, a data centre pays for more new power and power lines than it will use, under a long-term contract. The extra goes to everyone else. BC already does a version of this: when a new load is over about 150 MW, the grid upgrades it helps pay for under BC Hydro’s tariff can include new generation. Data centres asked for twice the power BC can offer, so BC can set the bar.</p>
              <p class="srcs"><a href="https://app.bchydro.com/content/dam/hydro/medialib/internet/documents/appcontent/your_account/Electric_Tariff_Supplement_Number_6.pdf" target="_blank" rel="noopener">BC Hydro Tariff Supplement 6</a> <a href={U.ohio} target="_blank" rel="noopener">AEP Ohio</a> <a href={U.ireland} target="_blank" rel="noopener">CRU, Ireland’s regulator, Dec 2025</a></p>
            </li>
            <li>
              <h3>Flex when the grid is tight</h3>
              <p>Data centres can pause or shift some computing for a few hours when the grid is strained. Google has agreed to do this with two US utilities. BC’s 2026 call already makes every applicant agree to cut its use by at least 10% of what it asked for, at least 4 hours at a time, on a day’s notice, with no compensation. That matters most in the years before the new power they pay for comes online.</p>
              <p class="srcs"><a href="https://blog.google/innovation-and-ai/infrastructure-and-cloud/global-network/how-were-making-data-centers-more-flexible-to-benefit-power-grids/" target="_blank" rel="noopener">Google, Aug 2025</a> <a href={U.rfa} target="_blank" rel="noopener">BC Hydro 2026 request for applications</a> <a href={U.reg} target="_blank" rel="noopener">B.C. Reg. 8/2026</a></p>
            </li>
            <li>
              <h3>Water rules first</h3>
              <p>Closed-loop cooling, metered use, public water reports, and limits in drought.</p>
              <p class="srcs"><a href={U.groundwater} target="_blank" rel="noopener">Government of BC</a> <a href={U.drought} target="_blank" rel="noopener">BC Gov News, Aug 28, 2026</a></p>
            </li>
            <li>
              <h3>Keep data in Canadian hands</h3>
              <p>Each data centre says how much of its space goes to Canadian-controlled computing. That promise goes into its power contract and is published.</p>
              <p class="srcs"><a href={U.rfa} target="_blank" rel="noopener">BC Hydro 2026 request for applications</a></p>
            </li>
            <li>
              <h3>First Nations partnership and public reporting</h3>
              <p>First Nations own part of the new generation, as in BC Hydro’s 2025 call for power, where every project is 51% First Nations-owned. Every winner’s commitments are published each year.</p>
              <p class="srcs"><a href={U.call} target="_blank" rel="noopener">BC Gov News, May 2026</a></p>
            </li>
          </ol>

          <h3 class="terms-h">A win for everyone</h3>
          <ul class="stats wins">
            <li>
              <p class="stat-label">Households</p>
              <p class="stat-num">88%</p>
              <p>of British Columbians in a July 2026 Leger poll worry that AI data centres could raise their power bills. Under this deal, data centres bring more new power than they use, so the grid grows and your bill doesn’t pay for their share.</p>
              <p class="srcs"><a href={U.leger} target="_blank" rel="noopener">Leger, July 2026</a> <span>(BC sample: 151 people)</span></p>
            </li>
            <li>
              <p class="stat-label">BC</p>
              <p class="stat-num">$2B+</p>
              <p>of First Nations ownership in the four new wind projects, each 51% First Nations-owned.</p>
              <p class="srcs"><a href={U.call} target="_blank" rel="noopener">BC Gov News, May 2026</a></p>
            </li>
            <li>
              <p class="stat-label">Data centres</p>
              <p class="stat-num">~800 MW</p>
              <p>asked for, with 400 on offer. A clear rule gives them a way in: bring more power than you use, follow the water and data rules, and you can connect.</p>
              <p class="srcs"><a href={U.cfd} target="_blank" rel="noopener">BC Hydro, 2026 Call for Demand</a></p>
            </li>
          </ul>
        </div>
      </section>

      <section class="act" id="act">
        <div class="wrap act-grid">
          <div class="act-intro">
            <h2>Find your MLA by postal code and email them.</h2>
            <p>
              Your MLA works for the people in your riding. An email from your own inbox, with your address, shows you’re a constituent. It takes about a minute.
            </p>
          </div>

          <div class="panel">
            <noscript>
              <p class="warn">This tool needs JavaScript. Without it, find your riding at <a href="https://elections.bc.ca/mydistrict/" target="_blank" rel="noopener">elections.bc.ca/mydistrict</a>, then find your MLA’s email at <a href="https://www.leg.bc.ca/members" target="_blank" rel="noopener">leg.bc.ca/members</a>.</p>
            </noscript>
            <form id="lookup" class="lookup" autocomplete="on">
              <label for="postal">Your postal code</label>
              <p class="hint" id="postal-hint">Like V8V 1X4</p>
              <div class="row">
                <input id="postal" name="postal" autocomplete="postal-code" maxlength="10" required aria-describedby="postal-hint lookup-error" />
                <button class="btn btn-ink" id="find-btn" type="submit">Find my MLA</button>
              </div>
              <p class="error" id="lookup-error" role="alert" hidden></p>
              <button class="geo" id="geo" type="button" hidden>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
                <span>Use my location</span>
              </button>
              <label class="alt" for="riding-select">Or choose your riding</label>
              <select id="riding-select">
                <option value="">Choose a riding</option>
                {ridings.map((r) => <option value={r}>{r}</option>)}
              </select>
            </form>

            <fieldset id="choose" class="choose" hidden>
              <legend>More than one riding matches. Which one is yours?</legend>
              <div id="choose-buttons"></div>
            </fieldset>

            <div id="compose" class="compose" hidden>
              <div class="mla">
                <h3 class="mla-name" id="mla-name" tabindex="-1"></h3>
                <p class="mla-meta" id="mla-meta"></p>
                <a class="mla-email" id="mla-email"></a>
              </div>
              <p class="warn" id="mla-match" hidden>Matched from your postal code. Not right? Use your location or choose your riding. You can also check at <a href="https://elections.bc.ca/mydistrict/" target="_blank" rel="noopener">elections.bc.ca/mydistrict</a>.</p>
              <p class="warn" id="mla-warn" hidden></p>

              <label for="sender-name">Your name</label>
              <input id="sender-name" autocomplete="name" aria-describedby="name-error" />
              <p class="error" id="name-error" hidden>Add your name so your MLA knows who wrote.</p>
              <label for="sender-address">Your street address</label>
              <p class="opt hint" id="address-hint">So the office knows you’re a constituent. Like 123 Main St, Victoria.</p>
              <input id="sender-address" autocomplete="street-address" aria-describedby="address-hint" />
              <label for="sender-why">What’s one thing about where you live or work that this affects?</label>
              <p class="opt hint" id="why-hint">Optional. One sentence in your own words helps your letter stand out. Or tap a reason below to start from.</p>
              <input id="sender-why" maxlength="200" aria-describedby="why-hint" placeholder="I work in Kamloops, and…" />
              <div class="reasons" role="group" aria-label="Reasons you can start from">
                {reasons.map((r) => <button class="chip reason" type="button" aria-pressed="false">{r}</button>)}
              </div>
              <label for="letter">Your letter <span class="opt">edit anything you like</span></label>
              <textarea id="letter" rows="14"></textarea>

              <a class="btn btn-hot btn-send" id="send-mailto" href="#">Open in my email app</a>
              <p class="warn" id="mode-warn" hidden>Your letter is long, so copy it instead of opening your email app.</p>
              <div class="send-alt">
                <span>Or copy and paste it into any email</span>
                <button id="copy-address" type="button">Copy address</button>
                <button id="copy-letter" type="button">Copy letter</button>
                <a class="web-only" id="send-gmail" href="#" target="_blank" rel="noopener">Gmail</a>
                <a class="web-only" id="send-outlook" href="#" target="_blank" rel="noopener">Outlook</a>
              </div>
              <p class="warn" id="copy-help" hidden></p>

              <p class="check-help" id="sent-help" hidden>If your email app didn’t open, tap “Copy address” and “Copy letter” above, then paste them into a new email in any app.</p>

              <div class="share" id="share" hidden>
                <p id="share-msg" tabindex="-1"><strong>Thank you.</strong> Many MLA offices reply by email, so watch your inbox. Now ask two friends to write too: it takes them a minute.</p>
                <button class="btn btn-ink share-main" id="share-native" type="button">Share with a friend</button>
                <div class="share-row" id="share-row">
                  <a class="chip" id="share-sms">Text it</a>
