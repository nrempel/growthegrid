---
import '../styles/global.css';
import fontUrl from '../assets/fonts/archivo-wdth.woff2?url';

interface Props {
  title: string;
  description?: string;
  path?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  jsonLd?: string;
}
const { title, description, path = '/', ogTitle = title, ogDescription = description, noindex = false, jsonLd } = Astro.props;
const site = Astro.site?.toString() ?? 'https://growthegrid.ca/';
const url = new URL(path, site).toString();
// Bump ?v= whenever og.png changes, so share previews fetch the new image.
const image = new URL('/og.png?v=5', site).toString();
const imageAlt = 'Let data centres build BC’s next power plant. Email your MLA. Grow the Grid BC.';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#e4eef0" />
<title>{title}</title>
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={url} />}
{description && <meta name="description" content={description} />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{!noindex && (
  <>
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grow the Grid BC" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </>
)}
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
