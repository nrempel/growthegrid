  <path class="foot-ridge-far" d="M0,90 L0,45.5 20,46.6 40,46.8 60,46.1 80,44.6 100,42.6 120,40.5 140,38.4 160,36.8 180,35.8 200,35.6 220,36.2 240,37.4 260,39.0 280,40.6 300,42.1 320,43.1 340,43.7 360,43.7 380,43.3 400,42.6 420,41.7 440,41.0 460,40.5 480,40.1 500,40.0 520,39.8 540,39.4 560,38.6 580,37.2 600,35.2 620,32.5 640,29.3 660,25.9 680,22.6 700,19.7 720,17.6 740,16.4 760,16.3 780,17.1 800,18.7 820,20.9 840,23.3 860,25.5 880,27.4 900,28.8 920,29.7 940,30.1 960,30.2 980,30.2 1000,30.3 1020,30.6 1040,31.3 1060,32.2 1080,33.3 1100,34.4 1120,35.2 1140,35.6 1160,35.5 1180,35.0 1200,34.1 1220,33.0 1240,32.0 1260,31.5 1280,31.5 1300,32.4 1320,34.2 1340,36.6 1360,39.6 1380,42.8 1400,45.8 1420,48.4 1440,50.2 1460,51.2 1480,51.2 1500,50.4 1520,49.0 1540,47.3 1560,45.5 1580,43.7 1600,42.2 L1600,90 Z"/>
  <path class="foot-ridge-mid" d="M0,90 L0,64.3 20,64.9 40,64.4 60,62.8 80,60.5 100,57.9 120,55.5 140,53.4 160,51.9 180,50.7 200,49.6 220,48.4 240,46.9 260,45.2 280,43.3 300,41.7 320,40.9 340,41.2 360,42.7 380,45.3 400,48.7 420,52.2 440,55.4 460,57.7 480,58.9 500,59.1 520,58.5 540,57.5 560,56.8 580,56.4 600,56.8 620,57.6 640,58.7 660,59.8 680,60.5 700,60.8 720,60.7 740,60.5 760,60.5 780,61.1 800,62.4 820,64.3 840,66.6 860,68.6 880,69.9 900,70.0 920,68.8 940,66.3 960,63.0 980,59.2 1000,55.6 1020,52.6 1040,50.5 1060,49.2 1080,48.6 1100,48.4 1120,48.1 1140,47.6 1160,46.8 1180,46.1 1200,45.7 1220,45.8 1240,46.7 1260,48.3 1280,50.5 1300,52.6 1320,54.4 1340,55.3 1360,55.2 1380,54.1 1400,52.4 1420,50.5 1440,49.0 1460,48.4 1480,48.9 1500,50.5 1520,52.9 1540,55.6 1560,58.2 1580,60.4 1600,62.1 L1600,90 Z"/>
  <path class="foot-ridge-near" d="M0,90 L0,84.2 20,84.5 40,83.9 60,82.4 80,80.2 100,77.8 120,75.9 140,74.9 160,75.0 180,76.3 200,78.1 220,80.0 240,81.4 260,82.0 280,81.7 300,80.9 320,80.0 340,79.2 360,78.7 380,78.4 400,78.0 420,77.1 440,75.5 460,73.2 480,70.5 500,68.0 520,66.2 540,65.5 560,66.1 580,67.7 600,69.7 620,71.5 640,72.6 660,72.7 680,72.0 700,70.9 720,69.7 740,68.8 760,68.3 780,68.2 800,68.0 820,67.5 840,66.5 860,65.1 880,63.6 900,62.5 920,62.3 940,63.3 960,65.4 980,68.3 1000,71.2 1020,73.7 1040,75.2 1060,75.6 1080,75.2 1100,74.3 1120,73.5 1140,73.1 1160,73.2 1180,73.6 1200,74.1 1220,74.3 1240,74.1 1260,73.5 1280,73.0 1300,72.9 1320,73.7 1340,75.5 1360,78.1 1380,81.1 1400,83.7 1420,85.5 1440,86.1 1460,85.5 1480,84.0 1500,82.2 1520,80.6 1540,79.5 1560,79.1 1580,79.0 1600,79.0 L1600,90 Z"/>
</svg>
<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-main">
      <p class="foot-brand">Grow the Grid BC</p>
      <p>A bigger grid for everyone, paid for by the data centres that need it.</p>
      <a class="btn btn-hot foot-cta" href={act}>Email your MLA</a>
      {home && (
        <>
          <div class="foot-social">
            {social.map(([label, ch, href, d]) => (
              <a href={href} data-ch={`foot-${ch}`} target="_blank" rel="noopener" aria-label={`Share on ${label}`} title={label}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={d} /></svg>
              </a>
            ))}
            <button id="foot-copy" class="foot-copy" type="button" data-url={via('link')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
              <span>Copy link</span>
            </button>
          </div>
          <JoinForm id="foot-join" heading="Get campaign updates" dark />
        </>
      )}
    </div>
    <div>
      <h2 class="foot-h">Key sources</h2>
      <ul class="foot-list">
        <li><a href="https://www.bclaws.gov.bc.ca/civix/document/id/complete/statreg/8_2026" target="_blank" rel="noopener">B.C. Reg. 8/2026, the data centre power cap</a></li>
        <li><a href="https://app.bchydro.com/accounts-billing/electrical-connections/large-load/emerging-industries-connections.html" target="_blank" rel="noopener">BC Hydro 2026 Call for Demand</a></li>
        <li><a href="https://www.bchydro.com/news/press_centre/news_releases/2025/ltep.html" target="_blank" rel="noopener">BC Hydro demand forecast to 2030</a></li>
        <li><a href="https://news.gov.bc.ca/releases/2026ECS0014-000552" target="_blank" rel="noopener">BC’s 2025 call for power results</a></li>
      </ul>
    </div>
    <div>
      <h2 class="foot-h">About</h2>
      <ul class="foot-list">
        <li>Run by me, Nicholas Rempel, on my own time. Not funded by any data centre company, utility or political party.</li>
        <li>My personal view on a public policy question, not advice. Not affiliated with BC Hydro, the Government of BC, the Legislative Assembly, Elections BC or any party.</li>
        <li>Riding lookup by <a href="https://represent.opennorth.ca" target="_blank" rel="noopener">OpenNorth Represent</a>.</li>
        <li>The site is open source: <a href="https://github.com/nrempel/growthegrid" target="_blank" rel="noopener">see the code on GitHub</a>.</li>
        <li>No names or letters are stored, and no emails unless you join the update list. <a href="/privacy/">How privacy works here</a></li>
        <li>Questions or corrections: <a href="mailto:hello@growthegrid.ca">hello@growthegrid.ca</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap foot-base">
    <span>© 2026 Nicholas Rempel · Updated <time datetime={UPDATED}>{UPDATED_LABEL.replace(' ', '\u00a0')}</time></span>
    <a href="#top">Back to top</a>
  </div>
</footer>
