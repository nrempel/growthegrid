---
import { UPDATED, UPDATED_LABEL } from '../data/site';
import { socialLinks } from '../data/social';
import JoinForm from './JoinForm.astro';
const { home = false } = Astro.props;
const act = home ? '#act' : '/#act';
const site = Astro.site?.toString() ?? 'https://growthegrid.ca/';
const via = (ch: string) => `${site}?via=foot-${ch}`;
// Link icon from Lucide 1.68.0 (ISC, /licenses/LUCIDE-ISC.txt).
const social = socialLinks(site, 'foot');
---

