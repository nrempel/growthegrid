    <text class="how-t how-t-src-sub" x="90" y="247" text-anchor="middle">paid for by the</text>
    <text class="how-t how-t-src-sub" x="90" y="273" text-anchor="middle">data centre</text>

    <rect class="how-node-use" x="420" y="28" width="12" height="136" />
